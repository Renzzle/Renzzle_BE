# Copy to .env and fill in real values.
# Loaded by docker-compose.yml (env_file) and docker-compose.dev.yml.

# Database (MySQL)
# DB_ADDRESS is a full "host:port/dbname" string used as jdbc:mysql://${DB_ADDRESS}.
# docker-compose.dev.yml builds it from DB_NAME instead, so DB_NAME is needed either way.
DB_ADDRESS=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=

# Gmail SMTP (auth verification emails)
GMAIL_ADDRESS=
GMAIL_PASSWORD=

# Google Play IAP
# GOOGLE_APPLICATION_CREDENTIALS: container path of the mounted service account JSON
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Apple IAP
# APPLE_IAP_PRIVATE_KEY_PATH: container path of the mounted .p8 key
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_PRIVATE_KEY_PATH=

# Caddy (reverse proxy / TLS)
ACME_EMAIL=
ACTUATOR_TOKEN=

# Loki (only used with the "observability" compose profile)
LOKI_TOKEN=

# API docs toggle
DOCS_ENABLED=true

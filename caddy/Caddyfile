{
	email {$ACME_EMAIL}

	servers {
		# The origin only accepts traffic from Cloudflare, so its edge ranges are the
		# trusted hop. Refresh from https://www.cloudflare.com/ips-v4 and /ips-v6
		# whenever Cloudflare publishes a change (last synced 2026-09-08).
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

renzzle.com, www.renzzle.com {
	tls /etc/caddy/origin/renzzle.com.pem /etc/caddy/origin/renzzle.com.key

	handle /app-ads.txt {
		header Content-Type text/plain
		respond "google.com, pub-8517144519151386, DIRECT, f08c47fec0942fa0" 200
	}

	@actuator_unauth {
		path /actuator/*
		not header Authorization "Bearer {$ACTUATOR_TOKEN}"
	}
	handle @actuator_unauth {
		respond 403
	}

	handle {
		reverse_proxy app:9001 {
			# {remote_host} would be the Cloudflare edge; {client_ip} resolves the
			# real client through trusted_proxies + client_ip_headers above.
			header_up X-Real-IP {client_ip}
		}
	}
}
